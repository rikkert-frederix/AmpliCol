              SuperscriptBox["mi", "2"], "-", 
              SuperscriptBox["pzpp", "2"]}]]}], "+", 
           RowBox[{"pzpp", " ", "siny"}]}], ")"}]}]}], ")"}], "2"], 
     SuperscriptBox["mir", "2"]]}], "/.", 
   RowBox[{"{", 
    RowBox[{"siny", "->", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "-", 
       RowBox[{"cosy", "^", "2"}]}], "]"}]}], "}"}]}]}]], "Input",
