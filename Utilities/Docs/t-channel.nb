Cell[BoxData[
 RowBox[{"minET", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"cosy", " ", "pzpp"}], "-", 
        RowBox[{"cosphi", " ", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["Epp", "2"], "-", 
           SuperscriptBox["mi", "2"], "-", 
           SuperscriptBox["pzpp", "2"]}]], " ", "siny"}]}], ")"}], "2"]}], 
    "+", 
